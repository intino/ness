dsl Legio

Artifact("systems.intino.eventsourcing", "1.1.0") datahub-builder
	Imports
		Compile("systems.intino.eventsourcing", "datahub", "13.0.0")
			Exclude("systems.intino.eventsourcing", "ingestion")
			Exclude("systems.intino.eventsourcing", "sealing")
			Exclude("io.intino.alexandria", "exceptions")
			Exclude("io.intino.alexandria", "jms")
			Exclude("io.intino.alexandria", "jmx")
			Exclude("io.intino.alexandria", "ui-framework")
			Exclude("org.yapache.activemq", "activemq-broker")
			Exclude("org.apache.activemq", "activemq-mqtt")
			Exclude("org.apache.activemq", "activemq-kahadb-store")
			Exclude("org.apache.activemq", "activemq-jaas")
			Exclude("org.apache.activemq", "activemq-runtime-config")
			Exclude("io.intino", "datalake-inspector")
		Compile("io.intino", "builder-interface", "2.2.0")
		Compile("io.intino.magritte", "builder", "7.1.0")
		Compile("io.intino.tara", "language", "1.6.1")
		Compile("io.intino.alexandria", "json", "1.2.3")
		Compile("io.intino.magritte", "framework", "5.1.0")
		Compile("io.intino.alexandria", "logger", "2.1.0")
		Compile("io.intino.itrules", "engine", "2.0.2")
		Compile("org.apache.maven.shared", "maven-invoker", "3.3.0")
		Compile("commons-codec", "commons-codec", "1.18.0")
		Compile("org.apache.commons", "commons-lang3", "3.17.0")
		Test("io.intino.alexandria", "bpm-framework", "3.1.4")

		Test("junit", "junit", "4.13.2")
	Package(mode = ModulesAndLibrariesLinkedByManifest, attachSources = true) as Runnable("systems.intino.eventsourcing.datahubbuilder.NesscRunner")
	Distribution
		Artifactory("intino-maven")
			Release("https://artifactory.intino.io/artifactory/release-libraries")
			Snapshot("https://artifactory.intino.io/artifactory/snapshot-libraries")
