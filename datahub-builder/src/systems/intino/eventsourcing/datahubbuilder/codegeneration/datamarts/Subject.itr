rule type(subject, root)
	package $package.subjects;

	import java.time.*;
	import java.util.*;
	import java.util.stream.*;
	import systems.intino.datamarts.subjectstore.model.Subject;

	public class $name+FirstUpperCase <<extends $parent ?extends systems.intino.eventsourcing.datahubterminal.datamart.SubjectWrapper >>{
		<<$attribute+wordDeclaration...[$NL]>>

		public $abstract~$name+FirstUpperCase(Subject core, systems.intino.eventsourcing.datahubterminal.datamart.Datamart datamart) {
			super(core, datamart);
		}

		<<$attribute+getter...[$NL$NL]>>

		<<$expression+expressionDeclaration...[$NL$NL]>>

		<<$struct+getter...[$NL$NL]>>

    	<<$struct+class...[$NL$NL]>>
    }

rule type(struct) and trigger(class)
	public class $name+firstUpperCase {
		private final String prefix;

		public $name+FirstUpperCase(String prefix) {
			this.prefix = prefix;
		}

		<<$attribute+getter...[$NL$NL]>>

		<<$struct+getter...[$NL$NL]>>

		<<$struct+class...[$NL$NL]>>
	}

rule trigger(constructor)
	String prefix;



rule trigger(super)
	super(index)

rule type(struct, multiple) and trigger(getter)
	public java.util.stream.Stream<$name+firstUpperCase> $name+firstLowerCase+Plural() {
		Iterator<$name+firstUpperCase> iterator = new Iterator<>() {
			private int next = 0;
			private String value = current$$().text(<<$isStruct+prefix ?"$name+firstUpperCase." + >>next + ".");

			@Override
			public boolean hasNext() {
				return value != null;
			}

			@Override
			public $name+firstUpperCase next() {
				if (value == null) return null;
				var currentValue = new $name+firstUpperCase(<<$isStruct+prefix ?"$name+firstUpperCase." + >>next + ".");
				this.next++;
				this.value = current$$().text(<<$isStruct+prefix ?"$name+firstUpperCase." + >>next + ".");
				return currentValue;
			}
		};
		return StreamSupport.stream(Spliterators.spliteratorUnknownSize(iterator, Spliterator.ORDERED), false);
	}

rule type(struct) and trigger(getter)
	public $name+firstUpperCase $name+firstLowerCase() {
		return new $name+firstUpperCase(<<$isStruct+prefix?"$name+firstUpperCase" + ".">>);
	}

rule type(attribute, multiple, text) and trigger(getter)
	public java.util.List<String> $name+firstLowerCase() {
		String value = current$$().text(<<$isStruct+prefix >>"$name");
		return value == null ? java.util.Collections.emptyList() : java.util.List.of(value.split("\\0"));
	}

