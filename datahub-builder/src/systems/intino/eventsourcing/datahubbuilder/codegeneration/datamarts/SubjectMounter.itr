rule not type(abstract) and type(mounter) and type(message)
	package $package.mounters;

	import $package.$datamart+firstUpperCase~Datamart;
	import systems.intino.eventsourcing.event.Event;
	import systems.intino.eventsourcing.event.message.MessageEvent;
	import systems.intino.eventsourcing.message.Message;
	import systems.intino.eventsourcing.datahubterminal.datamart.SubjectListener;
	import systems.intino.eventsourcing.datahubterminal.datamart.SubjectWrapper;

	import java.time.*;
	import java.util.*;
	import java.util.stream.*;

	import systems.intino.eventsourcing.event.Event;
	import systems.intino.eventsourcing.event.message.MessageEvent;
	import systems.intino.eventsourcing.message.Message;
	import $ontologypackage.subjects.$name+FirstUpperCase;

	import static systems.intino.eventsourcing.datahubterminal.datamart.SubjectMounter.Operation.*;

	public class $name+FirstUpperCase~Mounter implements systems.intino.eventsourcing.datahubterminal.datamart.SubjectMounter {
		private $datamart+FirstUpperCase~Datamart datamart;
		private final List<SubjectListener<SubjectWrapper>~> listeners;
		private boolean useListeners = true;

		public $name+FirstUpperCase~Mounter($datamart+FirstUpperCase~Datamart datamart) {
			this.datamart = datamart;
			this.listeners = this.datamart.core$$().listenersOf("$name+FirstUpperCase");
		}

		public $name+FirstUpperCase~Mounter useListeners(boolean useListeners) {
			this.useListeners = useListeners;
			return this;
		}

		public void mount(Event event) {
			Message message = ((MessageEvent) event).toMessage();
			String id = message.get("subject").asString();
			Operation[] operation = {Update};
			$name+FirstUpperCase subject = findOrCreateSubject(id, message.type(), operation);
			updateAttributes(event, operation, subject);
			if (operation[0] != Skip && useListeners) notifyListeners(subject, operation[0]);
		}

		private void updateAttributes(Event event, Operation[] operation, $name+FirstUpperCase subject) {
			if (datamart.core$$().localAccess()) return;
			Message message = ((MessageEvent) event).toMessage();
			Map<String, Object> map = message.attributes().stream().collect(Collectors.toMap(k -> k, k -> parse(k, message)));
			<<Map<String, List<Message>~> componentsByType = message.components().stream().collect(Collectors.groupingBy(Message::type));
			$struct+setStructComponent...[$NL]>>
			subject.update$$(event.ts(), event.ss(), map);
		}

		private $name+FirstUpperCase findOrCreateSubject(String id, String type, Operation[] operation) {
			$name+FirstUpperCase subject = datamart.$name+FirstLowerCase(id);
			if (subject == null && !datamart.core$$().localAccess()) {
				subject = new $name+FirstUpperCase(datamart.core$$().createSubject(type, id));
				operation[0] = Create;
			}
			return subject;
		}

		private void notifyListeners($name+FirstUpperCase subject, Operation operation) {
			for(SubjectListener listener : listeners) {
				new Thread(() -> listener.onChange(subject, operation), "$datamart+FirstUpperCase~Listener-$name+FirstUpperCase~Mounter-" + System.currentTimeMillis()).start();
			}
		}

		private Object parse(String attribute, Message message) {
			if(message.get(attribute).isNull()) return null;
			switch(attribute) {
				<<$attribute+parseSwitchCase...[$NL]>>
			}
			return message.get(attribute).asString();
		}

		<<$attribute+parseMethod...[$NL$NL]>>

		<<$struct+factory...[$NL$NL]>>
	}

rule type(struct) and trigger(factory)
	private static class $name~StructFactory {

		private static Map<String, Object> structsAttributes(List<Message> messages) {
					LinkedHashMap<String, Object> map = new LinkedHashMap<>();
					messages.forEach(c -> {
								for (int i = 0; i < messages.size(); i++) {
									for (String a : c.attributes())
										map.put(String.join(".", c.type(), i + "", a), parse(c.attributes().get(i), c));
								}
							}
					);
					return map;
				}

		private static Object parse(String attribute, Message message) {
			if(message.get(attribute).isNull()) return null;
			switch(attribute) {
				<<$attribute+parseSwitchCase...[$NL]>>
			}
			return message.get(attribute).asString();
		}

		<<$attribute+parseMethod...[$NL$NL]>>

		<<$struct+factory...[$NL$NL]>>
	}

rule type(multiple) and trigger(setStructComponent)
	if(componentsByType.containsKey("$typename")) map.putAll($name~StructFactory.structsAttributes(componentsByType.get("$typename")));

rule trigger(parseSwitchCase)
	case "$name": return parse$name+FirstUpperCase~(message);

rule type(attribute) and type(list) and type(subject) and trigger(parseMethod)
	private static java.util.List<String> parse$name+FirstUpperCase(Message m) {
		var value = m.get("$name");
		return value.data().isEmpty() ? java.util.Collections.emptyList() : value.asList(String.class);
	}

rule type(attribute) and type(set) and type(subject) and trigger(parseMethod)
	private static java.util.Set<String> parse$name+FirstUpperCase(Message m) {
