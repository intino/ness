rule type(attribute) and (type(list) or type(set)) and (type(date) or type(datetime)) and trigger(parseMethod)
	private static $type parse$name+FirstUpperCase(Message m) {
		try {
			return java.util.Arrays.stream(m.get("$name").as(String[].class))
				.map(s -> {try{return $typeParameter.parse(s);}catch(Exception ignored){return null;}})
				.filter(java.util.Objects::nonNull)
				.collect(java.util.stream.Collectors.to$collectionType+FirstUpperCase());
		} catch(Exception ignored) {
			return null;
		}
	}

