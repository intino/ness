dsl Proteo

use Model

Concept:Named Datamart
	Concept:{0..1} Snapshots
		var word:SnapshotScale scale = None
		var word:DayOfWeek firstDayOfWeek = MONDAY
		var integer maxCount = -1
	has Subject

Concept:Named Subject
	var Datalake.Tank.Message[]:HasSubjectId from = empty
	Concept Include > var Attribute:MustContainedInFrom attribute
		Facet Reference > var Datamart.Subject subject
		Facet Struct
			var Component:MustContainedInFrom messageComponent
			var Attribute:MustContainedInFrom attribute = empty

	Concept:Named:RequiresFacet Method extends Expression
	Facet ExtensionOf > var Subject subject
	Facet Abstract
		var Datalake.Tank.Message from = empty is private final
	Facet Decorable

Concept Expression is abstract
	Facet Private
	Facet Getter
		var string expression
		sub DoubleGetter
		sub IntegerGetter
		sub LongGetter
		sub BooleanGetter
		sub TextGetter
		sub DateGetter
		sub DateTimeGetter
		sub InstantGetter
	Facet Function
		var string expression
		Concept:{1..1}:RequiresFacet ReturnType extends SubjectData
   		Concept:Named:RequiresFacet Parameter extends SubjectData
	Facet Routine
		var string expression
   		Concept:Named:RequiresFacet Parameter extends SubjectData

Concept SubjectData is abstract
	Facet List
	Facet Set
	Facet Type
		var string type is private
		sub Double
			var double defaultValue = empty
			var string type = "Double" is private
		sub Integer
			var integer defaultValue = empty
			var string type = "Integer" is private
		sub Long
			var long defaultValue = empty
			var string type = "Long" is private
		sub Boolean
			var boolean defaultValue = empty
			var string type = "Boolean" is private
		sub Text
			var string defaultValue = empty
			var string type = "String" is private
		sub Date
			var string format = "dd/MM/yyyy"
			var string type = "java.util.Date" is private
		sub DateTime
			var string format = "dd/MM/yyyy HH:mm:ss"
			var string type = "java.time.DateTime" is private
		sub Instant
			var instant defaultValue = empty
			var string type = "java.time.Instant" is private
		sub Word
			var string[] values
			var string defaultValue = empty
			var string type = "java.lang.Enum" is private
		sub Subject
			var Datamart.Subject subject
		sub Map
			var string type = "java.util.Map" is private
