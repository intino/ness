Namespace ciudad

	Message EventoProceso is abstract
		Attribute idEjecucion as Text
		Attribute nombreProceso as Text
		Attribute versionProceso as Text
		Attribute versionControlador as Text

	Message CargaIncidencia as ExtensionOf(EventoProceso)
		Attribute fuente as Text
    	Attribute soporte as Text
    	Attribute vista as Text
    	Attribute tipo as Word("ProcesoNoDefinido" "ErrorDeConexion" "ErrorDeAutenticacion" "ErrorDeTimeout" "DatasetNoDisponible" "DatasetVacio" "FormatoNoSoportado" "FicheroCorrupto" "ErrorDeAlmacenamiento" "ErrorDeBaseDeDatos" "CredencialesNoDisponibles" "EjecucionCancelada" "ErrorDesconocido" "CargaFallida")
    	Attribute mensaje as Text

	Message CargaRealizada as ExtensionOf(EventoProceso)
		Attribute fuente as Text
    	Attribute soporte as Text
    	Attribute startTs as DateTime
    	Attribute endTs as DateTime
    	Attribute registros as LongInteger
    	Attribute registrosError as Integer
    	Attribute registrosNuevos as Integer
    	Attribute registrosActualizados as Integer
    	Attribute registrosEliminados as Integer
    	Component(multiple=true) VistaExtraida
    		Attribute nombre as Text
    		Attribute exito as Bool
    		Attribute tipo as Word ("SQL" "API")
    		Attribute startTs as DateTime
            Attribute endTs as DateTime
    		Attribute registros as Integer
    		Attribute registrosError as Integer
    		Attribute reintentos as Integer
    		Attribute registrosNuevos as Integer
            Attribute registrosActualizados as Integer
            Attribute registrosEliminados as Integer

	Message ImportacionRealizada as ExtensionOf(EventoProceso)
		Attribute fuente as Text
		Attribute soporte as Text
		Attribute vista as Text
		Attribute sujetos as Integer
		Attribute tripletas as Integer
		Attribute tripletasTotales as Integer
		Attribute startTs as DateTime
		Attribute endTs as DateTime
		Component(multiple=true) Operacion
			Attribute tipo as Word("Transformacion" "Inferencia")
			Attribute nombre as Text
			Attribute atributo as Text
			Attribute vecesEjecutada as Integer
			Attribute errores as Integer

	Message ImportacionIncidencia as ExtensionOf(EventoProceso)
		Attribute fuente as Text
    	Attribute soporte as Text
    	Attribute vista as Text
    	Attribute tipo as Word("ProcesoNoDefinido" "VistaNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
    	Attribute mensaje as Text

   	Message RevisionRealizada as ExtensionOf(EventoProceso)
   		Attribute startTs as DateTime
        Attribute endTs as DateTime
       	Attribute fuente as Text
        Attribute soporte as Text
        Attribute vista as Text
        Component(multiple=true) Regla
        	Attribute nombre
        	Attribute descripcion
        	Attribute atributos as List Text
        	Attribute dimension as Word ("Consistencia" "Completitud" "Unicidad" "Validez" "Exactitud" "Actualidad")
        	Attribute tipo as Word ("Sintactica" "Semantica" "Pragmatica")
        	Attribute incumplimientos as Integer
        	Attribute sujetosAfectados as Integer

   	Message RevisionIncidencia as ExtensionOf(EventoProceso)
   		Attribute fuente as Text
       	Attribute soporte as Text
       	Attribute vista as Text
       	Attribute tipo as Word("ProcesoNoDefinido" "VistaNoDisponible" "FacetaNoDisponible" "DatasetNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
       	Attribute mensaje as Text

    Message ConciliacionRealizada as ExtensionOf(EventoProceso)
   		Attribute startTs as DateTime
        Attribute endTs as DateTime
    	Attribute fuente as Text
       	Attribute soporte as Text
        Attribute vista as Text
        Attribute sujetos as Integer
        Attribute sujetosUnicos as Integer

    Message ConciliacionIncidencia as ExtensionOf(EventoProceso)
   		Attribute fuente as Text
        Attribute soporte as Text
        Attribute vista as Text
        Attribute tipo as Word("ProcesoNoDefinido" "VistaNoDisponible" "FacetaNoDisponible" "DatasetNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
		Attribute mensaje as Text

	Message ConsolidacionRealizada as ExtensionOf(EventoProceso)
		Attribute startTs as DateTime
		Attribute endTs as DateTime
		Attribute faceta as Text
		Attribute fuentes as Text List
        Attribute sujetos as Integer
        Attribute sujetosUnicos as Integer
        Component Dataset
        	Attribute tipo as Word("Primario" "Maestro")
        	Attribute nombre as Text
        	Attribute fuente as Text
        	Attribute soporte as Text
        	Attribute vista as Text
        	Attribute faceta as Text
        	Attribute fecha as DateTime
        Component(multiple=true) Solapamiento
       		Attribute datasets as Text List
            Attribute sujetos as Integer

	Message ConsolidacionIncidencia as ExtensionOf(EventoProceso)
		Attribute faceta as Text
		Attribute fuentes as Text List
    	Attribute tipo as Word("ProcesoNoDefinido" "FacetaNoDisponible" "DatasetNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
    	Attribute mensaje as Text

	Message AnalisisPrimarioRealizado as ExtensionOf(EventoProceso)
		Attribute startTs as DateTime
    	Attribute endTs as DateTime
   		Attribute fuente as Text
        Attribute soporte as Text
        Attribute vista as Text
    	Component Calidad
    		Component(multiple=true) Atributo
    			Attribute nombre as Text
    			Attribute consistencia as Real
    			Attribute completitud as Real
    			Attribute unicidad as Real
    			Attribute validez as Real
    			Attribute exactitud as Real
    			Attribute actualidad as Real
    	Attribute json as Text // TODO: ELIMINAR

	Message AnalisisPrimarioIncidencia as ExtensionOf(EventoProceso)
   		Attribute fuente as Text
        Attribute soporte as Text
        Attribute vista as Text
    	Attribute tipo as Word("ProcesoNoDefinido" "VistaNoDisponible" "DatasetNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
    	Attribute mensaje as Text

	Message AnalisisMaestroRealizado as ExtensionOf(EventoProceso)
		Attribute startTs as DateTime
    	Attribute endTs as DateTime
    	Attribute faceta as Text
    	Component Calidad
    		Component(multiple=true) Atributo
    			Attribute nombre as Text
    			Attribute consistencia as Real
    			Attribute completitud as Real
    			Attribute unicidad as Real
    			Attribute validez as Real
    			Attribute exactitud as Real
    			Attribute actualidad as Real
    	Attribute json as Text // TODO: ELIMINAR

	Message AnalisisMaestroIncidencia as ExtensionOf(EventoProceso)
		Attribute faceta as Text
    	Attribute tipo as Word("ProcesoNoDefinido" "FacetaNoDisponible" "DatasetNoDisponible" "EjecucionCancelada" "ErrorDesconocido")
    	Attribute mensaje as Text



