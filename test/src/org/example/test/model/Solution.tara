dsl Ness

use Datamart
use Datalake

Broker(path = empty, port = 63000, secondaryPort = 1884)
	User("trooper", "trooper")
	User("monet", "monet")
	User("wizard", "wizard")
	User("consul", "consul")
	User("cesar", "cesar")
	User("connector", "connector")
	User("federation", "federation")
	User("master", "master")
	Bridge(topics = "example.topic1")
		ExternalBus(url = "tcp://localhost:62000", user = "wizard", password = "wizard", sessionId = "test-bridge1")

Terminal wizard-terminal
	Publish(dl.incident dl.incidentFinished dl.status dl.computer dl.operationStarted dl.operationFinished dl.analysis)
	Subscribe(dl.incident dl.status dl.computer dl.operationStarted dl.operationFinished dl.operationCancelled dl.orderStarted dl.orderFinished dl.orderCancelled dl.rdbmsStatement dl.application dl.camera dl.cellularGateway dl.switch, dl.log)
	Datamarts(master)
