dsl Ness

use Datalake
use Universe
use Events


Datamart master
	Snapshots(scale = Day)

	Subject(dl.place) Place
		Include(universe.Place.label)
		Include(universe.Place.coordinates)
		Include(universe.Place.timeOffset)
		Include(universe.Place.region)
		Include(universe.Place.city)
		Include(universe.Place.area) as Reference(Area)
		Include(universe.Place.address)
		Include(universe.Place.postalCode)

	Subject(dl.area) Area > Include(universe.Area.label)

	Subject(dl.incidentRuleAssertion) IncidentRule
		Include(universe.IncidentRule.target)
		Include(universe.IncidentRule.model)
		Include(universe.IncidentRule.condition)
		Include(universe.IncidentRule.precondition)
		Include(universe.IncidentRule.level)
		Include(universe.IncidentRule.tracking)
		Include(universe.IncidentRule.dismissCondition)
		Include(universe.IncidentRule.description)
		Include(universe.IncidentRule.triggers)

	Subject(dl.countermeasureAssertion) Countermeasure
		Include(universe.Countermeasure.condition)
		Include(universe.Countermeasure.priority)
		Include(messageComponent = universe.Countermeasure.Actuation) as Struct
			attribute = empty
	Subject(dl.modelAssertion) Model
		Include(universe.ModelAssertion.type)
		Include(attribute = empty) as Struct(universe.ModelAssertion.Profile)
	Subject(dl.orderTypeAssertion) OrderType

	Subject Observable as Abstract
		Include(universe.Observable.label)
		Include(universe.Observable.place) as Reference(Place)
		Include(universe.Observable.team)
		Include(universe.Observable.model) as Reference(Model)
		Include(universe.Observable.container) as Reference(Observable)
		Include(universe.Observable.observer) as Reference(Observer)
		Include(universe.Observable.responsible) as Reference(Person)
		Include(universe.Observable.tags)
		Include as Struct(universe.Observable.Operation)
			attribute = empty
	Subject(dl.personAssertion) Person as ExtensionOf(Observable)
		Include(universe.PersonAssertion.area) as Reference(Area)
		Include(universe.PersonAssertion.role)
		Include(universe.PersonAssertion.supervisor) as Reference(Person)
		Include(universe.PersonAssertion.email)
		Include(universe.PersonAssertion.phone)

	Subject(dl.processAssertion) Process as ExtensionOf(Observable)

	Subject(dl.assetAssertion) Asset as ExtensionOf(Observable)
	Subject(dl.partAssertion) Part as ExtensionOf(Observable)

	Subject(dl.hardwareAssertion) Hardware as ExtensionOf(Observable)
		Include(universe.HardwareAssertion.sn)
		Include(universe.HardwareAssertion.ip)
		Include(universe.HardwareAssertion.publicIp)

	Subject(dl.applianceAssertion dl.switch) Appliance as ExtensionOf(Hardware)

	Subject(dl.computer) Computer as ExtensionOf(Hardware)
		Include(universe.Computer.architecture)
		Include(universe.Computer.os)
		Include(universe.Computer.cores)
		Include(universe.Computer.diskSize)
		Include(universe.Computer.memorySize)
		Include(universe.Computer.maxOpenFiles)
		Include(universe.Computer.jvm)
		Include(universe.Computer.isp)

	Subject(dl.software) Software as ExtensionOf(Observable)
	Subject(dl.observer) Observer as ExtensionOf(Software)
		Include(universe.Observer.version)
		Include(universe.Observer.installedActivities)
		Include(universe.Observer.enabledActivities)

	Subject(dl.serviceAssertion) Service as ExtensionOf(Software)
		Include(universe.Service.url)


	Subject(dl.application dl.application dl.status) Application as ExtensionOf(Software)
		Include(universe.Application.name)
		Include(universe.Application.user)
		Include(universe.Application.systemService)
		Include(universe.Application.startingTime)
		Include(universe.Application.pids)
		Include(universe.Application.commandLine)
		Include(universe.Application.state)
		Include(universe.Application.usageRAM)
        Include(universe.Application.usageCPU)
        Include(universe.Application.usageThreads)
        Include(universe.Application.usageFiles)
        Include(universe.Application.dataRead)
        Include(universe.Application.dataWritten)

	Subject(dl.applicationJava) ApplicationJava as ExtensionOf(Application)
		Include(universe.ApplicationJava.classpathPrefix)
		Include(universe.ApplicationJava.mainArtifact)
		Include(universe.ApplicationJava.debugPort)
		Include(universe.ApplicationJava.jmxPort)
		Include(universe.ApplicationJava.minMemory)
		Include(universe.ApplicationJava.maxMemory)
		Include(universe.ApplicationJava.classpath)
		Include(universe.ApplicationJava.inputArguments)
		Include(universe.ApplicationJava.jvmParameter)
		Include(universe.ApplicationJava.jvmVersion)
