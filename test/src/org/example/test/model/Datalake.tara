dsl Ness

use Events

Datalake(scale = Day, path = "{datalake}") dl
	Seal > Cron(pattern = "0 0 4 1/1 * ? *", timeZone = empty)

	Tank inventario as Message(inventario.Inventario)
	Tank unidad as Message(inventario.Unidad)
	Tank unidadEliminada as Message(inventario.UnidadEliminada)
	Tank reglaCalidad as Message(gobierno.ReglaCalidad)

	Tank fuenteCreada as Message(fuentes.FuenteCreada)
	Tank fuenteModificada as Message(fuentes.FuenteModificada)
	Tank fuenteEliminada as Message(fuentes.FuenteEliminada)
	Tank proveedorCreado as Message(fuentes.ProveedorCreado)
	Tank proveedorModificado as Message(fuentes.ProveedorModificado)
	Tank proveedorEliminado as Message(fuentes.ProveedorEliminado)
	Tank personaCreada as Message(fuentes.PersonaCreada)
	Tank personaModificada as Message(fuentes.PersonaModificada)
	Tank personaEliminada as Message(fuentes.PersonaEliminada)
	Tank integracionCreada as Message(fuentes.IntegracionCreada)
	Tank integracionModificada as Message(fuentes.IntegracionModificada)
	Tank integracionEliminada as Message(fuentes.IntegracionEliminada)
	Tank soporteCreado as Message(fuentes.SoporteCreado)
	Tank soporteModificado as Message(fuentes.SoporteModificado)
	Tank soporteEliminado as Message(fuentes.SoporteEliminado)
	Tank brechaCreada as Message(fuentes.BrechaCreada)
	Tank brechaModificada as Message(fuentes.BrechaModificada)
	Tank brechaEliminada as Message(fuentes.BrechaEliminada)
	Tank mejoraCreada as Message(fuentes.MejoraCreada)
	Tank mejoraModificada as Message(fuentes.MejoraModificada)
	Tank mejoraEliminada as Message(fuentes.MejoraEliminada)
	Tank repositorioCreado as Message(fuentes.RepositorioCreado)
	Tank repositorioModificado as Message(fuentes.RepositorioModificado)
	Tank repositorioEliminado as Message(fuentes.RepositorioEliminado)

	Tank datasetPrimarioCreado as Message(dominios.DatasetPrimarioCreado)
	Tank datasetPrimarioModificado as Message(dominios.DatasetPrimarioModificado)
	Tank datasetPrimarioEliminado as Message(dominios.DatasetPrimarioEliminado)
	Tank datasetMaestroCreado as Message(dominios.DatasetMaestroCreado)
	Tank datasetMaestroModificado as Message(dominios.DatasetMaestroModificado)
	Tank datasetMaestroEliminado as Message(dominios.DatasetMaestroEliminado)


	Tank cargaIncidencia as Message(ciudad.CargaIncidencia)
	Tank cargaRealizada as Message(ciudad.CargaRealizada)

	Tank importacionRealizada as Message(ciudad.ImportacionRealizada)
	Tank importacionIncidencia as Message(ciudad.ImportacionIncidencia)

	Tank revisionRealizada as Message(ciudad.RevisionRealizada)
	Tank revisionIncidencia as Message(ciudad.RevisionIncidencia)

	Tank conciliacionRealizada as Message(ciudad.ConciliacionRealizada)
	Tank conciliacionIncidencia as Message(ciudad.ConciliacionIncidencia)

	Tank consolidacionRealizada as Message(ciudad.ConsolidacionRealizada)
    Tank consolidacionIncidencia as Message(ciudad.ConsolidacionIncidencia)

    Tank analisisPrimarioRealizado as Message(ciudad.AnalisisPrimarioRealizado)
    Tank analisisPrimarioIncidencia as Message(ciudad.AnalisisPrimarioIncidencia)

	Tank analisisMaestroRealizado as Message(ciudad.AnalisisMaestroRealizado)
	Tank analisisMaestroIncidencia as Message(ciudad.AnalisisMaestroIncidencia)

