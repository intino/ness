dsl Ness

Namespace universe
	Message IncidentRule
		Attribute target as Text
		Attribute model as Text
		Attribute precondition as Text
		Attribute condition as Text
		Attribute dismissCondition as Text
		Attribute tracking as Text
		Attribute level as Word("Low" "Medium" "High")
		Attribute description as Text
		Attribute triggers as Text List

	Message Countermeasure
		Attribute condition as Text
		Attribute priority as Text
		Component Actuation
			Attribute id as Text
			Attribute name as Text
			Attribute label as Text
			Attribute target as Text
			Attribute tries as Integer
			Attribute tryInterval as Integer
			Attribute extraCondition as Text

	Message BusinessUnitAssertion
		Attribute label as Text
		Attribute domains as Text List

	Message Place
		Attribute label as Text
		Attribute area as Text
		Attribute coordinates as Text
		Attribute timeOffset as Integer
		Attribute region as Text
		Attribute city as Text
		Attribute address as Text
		Attribute postalCode as Text

	Message Area
		Attribute label as Text

	Message ModelAssertion
		Attribute type as Text
//		Attribute target as Text

		Component(multiple=false) Profile
			Component Variable
				Attribute name as Text
				Attribute className as Text
				Attribute label as Text
				Attribute type as Text
				Attribute operator as Text
				Attribute unit as Text
				Attribute symbol as Text
				Attribute priority as Integer
				Attribute values as Text List
				Attribute min as Text
				Attribute max as Text
				Attribute description as Text
				Attribute format as Text

	Message OrderTypeAssertion
		Attribute label as Text
		Attribute input as Text List
		Attribute model as Text
		Attribute effort as Integer
		Component(multiple = false) Assistant
			Component Step
				Attribute type as Word("Section" "Approval" "Coordinates" "Hidden" "Option" "Number" "Date" "Text" "Image" "Note" "Package" "Signature")
				Attribute code as Text
				Attribute title as Text
				Attribute description as Text
				Attribute values as Text
				Attribute maxValue as Text
				Attribute minValue as Text
				Attribute defaultValue as Text
				Attribute optional as Bool

	Message Observable
		Attribute label as Text
		Attribute place as Text
		Attribute team as Text
		Attribute model as Text
		Attribute container as Text
		Attribute observer as Text
		Attribute responsible as Text
		Attribute tags as Text List
		Component Operation
			Attribute activity as Text
			Attribute name as Text
			Component Procedure
				Attribute name as Text
				Attribute returnType as Text
				Attribute description as Text
				Component Parameter
					Attribute type as Text
					Attribute name as Text

	Message PersonAssertion as ExtensionOf(Observable)
		Attribute area as Text
		Attribute role as Text
		Attribute supervisor as Text
		Attribute email as Text
		Attribute phone as Text

	Message ProcessAssertion as ExtensionOf(Observable)

	Message AssetAssertion as ExtensionOf(Observable)
	Message PartAssertion as ExtensionOf(Observable)

	Message HardwareAssertion as ExtensionOf(Observable)
		Attribute sn as Text
		Attribute ip as Text List
		Attribute publicIp as Text

	Message ApplianceAssertion as ExtensionOf(HardwareAssertion)

	Message Computer as ExtensionOf(HardwareAssertion)
		Attribute architecture as Text
		Attribute os as Text
		Attribute cores as Integer
		Attribute diskSize as LongInteger  //MB
		Attribute memorySize as LongInteger //MB
		Attribute maxOpenFiles as LongInteger
		Attribute jvm as Text
		Attribute isp as Text
		Attribute usageRAM as Real > Metadata("MB") unit; Metadata("%,.2f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageHDD as Real > Metadata("MB") unit; Metadata("%,.2f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution
		Attribute usageCPU as Real > Metadata("%") unit; Metadata("%,.2f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageSystem as Real > Metadata("%,.2f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageThreads as Real > Metadata("%d") format; Metadata("last") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageFiles as Real > Metadata("%d") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute temperatureKernel as Real > Metadata("ºC") unit; Metadata("%,.0f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute temperatureExternal as Real > Metadata("ºC") unit; Metadata("%,.0f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute dataReceived as Real > Metadata("MB") unit; Metadata("%,.0f") format; Metadata("sum") operator; Metadata("UP") tail;
		Attribute dataSent as Real > Metadata("MB") unit; Metadata("%,.0f") format; Metadata("sum") operator; Metadata("UP") tail;
		Attribute applicationsSystem as Real > Metadata("%d") format; Metadata("last") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute applicationsKnown as Real > Metadata("%d") format; Metadata("last") operator; Metadata("UP") tail;
		Attribute applicationsUnknown as Real > Metadata("%d") format; Metadata("last") operator; Metadata("UP") tail;

	Message SoftwareAssertion as ExtensionOf(Observable)
	Message Observer as ExtensionOf(SoftwareAssertion)
		Attribute version as Text
		Attribute installedActivities as Text List
		Attribute enabledActivities as Text List

	Message Application as ExtensionOf(SoftwareAssertion)
		Attribute name as Text
		Attribute systemService as Text
		Attribute user as Text
		Attribute startingTime as DateTime
		Attribute pids as Integer List
		Attribute commandLine as Text
		Attribute state as Word("NEW" "RUNNING" "SLEEPING" "WAITING" "ZOMBIE" "STOPPED" "OTHER" "INVALID" "SUSPENDED")
		Attribute usageRAM as Real > Metadata("MB") unit; Metadata("%,.2f") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageCPU as Real > Metadata("%") unit; Metadata("%,.2f") format; Metadata("avg") operator; Metadata("100") max; Metadata("UP") tail;
		Attribute usageThreads as Real > Metadata("%d") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute usageFiles as Real > Metadata("%d") format; Metadata("avg") operator; Metadata("UP") tail; Metadata("Normal") distribution;
		Attribute dataRead as Real > Metadata("MB") unit; Metadata("%,.0f") format; Metadata("avg") operator; Metadata("UP") tail;
		Attribute dataWritten as Real > Metadata("MB") unit; Metadata("%,.0f") format; Metadata("avg") operator; Metadata("UP") tail;

	Message ApplicationJava as ExtensionOf(Application)
		Attribute groupId as Text
		Attribute artifactId as Text
		Attribute version as Text
		Attribute classpathPrefix as Text
		Attribute mainArtifact as Text
		Attribute debugPort as Integer
		Attribute jmxPort as Integer
		Attribute minMemory as Integer
		Attribute maxMemory as Integer
		Attribute classpath as Text List
		Attribute inputArguments as Text List
		Attribute jvmParameter as Text List
		Attribute jvmVersion as Text

	Message Service as ExtensionOf(SoftwareAssertion)
		Attribute url as Text


